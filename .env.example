# ==============================================================================
# SMELTRAVELS876 - Environment Configuration (.env.example)
# ==============================================================================
# Instructions: Copy this file to .env and configure your production credentials.
# On Hostinger, these values can also be set in hPanel > Advanced > Environment Variables.
# ==============================================================================

# Server Runtime Port (assigned automatically by Hostinger, or 3000 locally)
PORT=3000
NODE_ENV=production

# Application URL (production website domain)
APP_URL="https://smeltravels876.com"

# Resend Transactional Email API Key (Domain: smeltravels876.com)
# Used to dispatch booking confirmations and customer inquiry alerts from:
# - bookings@smeltravels876.com
# - notifications@smeltravels876.com
RESEND_API_KEY=""

# Authoritative Administrator Password
# Set a strong password for authorized administrator logins:
# Authorized accounts:
# - Elvoy Bennett (smeltravels876@gmail.com)
# - Zachary Buchanan (zbuchanan.smeltravels@gmail.com, zacpremacc12@gmail.com)
# - Jada Virgo (jvirgo.smeltravels@gmail.com)
# - Shenoya Davis (sdavis.smeltravels@gmail.com)
ADMIN_PASSWORD=""

# WiPay Caribbean Payment Gateway Integration
WIPAY_ACCOUNT_NUMBER=""
WIPAY_API_KEY=""
WIPAY_ENVIRONMENT="live"

# Optional Skyscanner Flight Pricing Key
SKYSCANNER_API_KEY=""

# Gemini AI (injected by AI Studio if enabled)
GEMINI_API_KEY=""
