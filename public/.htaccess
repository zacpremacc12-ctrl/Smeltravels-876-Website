# ==============================================================================
# SMELTRAVELS876 - Hostinger Apache / LiteSpeed Web Server Configuration
# ==============================================================================
# Domain: smeltravels876.com
# Purpose:
# 1. Allow Hostinger Node.js Express application to handle /api/* requests
# 2. Never rewrite /api/* requests to index.html (return real HTTP status)
# 3. Serve physical static assets directly from disk
# 4. Route Single Page Application (SPA) client routes to index.html
# 5. Enforce security headers and proper MIME types
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct Static Assets
  # If the requested physical asset exists on disk (images, css, js, icons), serve directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Do NOT rewrite /api/ requests to index.html
  # Any API call must be handled by the Node.js Express backend or return 404
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^ - [L]

  # 3. Single Page Application (SPA) Client Routing
  # All frontend client navigation routes are served index.html
  RewriteCond %{REQUEST_URI} !^/api/ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

# Security Headers & MIME Types
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType application/json .json
  AddType text/javascript .js .mjs
  AddType text/css .css
</IfModule>
